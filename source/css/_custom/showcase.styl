/* ============================================
   作品展示页样式 — 开源项目卡片 + B站视频
   ============================================ */

/* ---------- 开源项目卡片 ---------- */
.project-card {
  display: block;
  position: relative;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  border-radius: 12px;
  padding: 20px 24px;
  margin: 16px 0;
  border: 1px solid rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  cursor: pointer;
  text-decoration: none !important;
  color: inherit;
}

.project-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
  border-color: rgba(73, 177, 245, 0.4);
  text-decoration: none !important;
}

.project-card .project-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 8px;
}

.project-card .project-name {
  font-size: 1.1em;
  font-weight: bold;
  color: #49b1f5;
  transition: color 0.3s ease;
}

.project-card:hover .project-name {
  color: #ff7242;
}

.project-card .project-langs {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.project-card .project-lang {
  font-size: 0.75em;
  font-weight: 600;
  padding: 2px 10px;
  border-radius: 20px;
  background: rgba(128, 128, 128, 0.15);
  color: #666;
}

.project-card .project-desc {
  color: #4c4948;
  margin: 8px 0 12px 0;
  line-height: 1.6;
}

.project-card .project-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.project-card .project-tag {
  font-size: 0.8em;
  color: #999;
}

