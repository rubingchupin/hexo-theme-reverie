/* ---------- B站视频容器 ---------- */
.bilibili-box {
  position: relative;
  width: 100%;
  padding-top: 56.25%;
  margin: 16px 0;
}

.bilibili-box iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 8px;
  border: none;
}

/* ---------- 音乐胶囊 ---------- */
.music-card {
  display: flex;
  align-items: center;
  gap: 18px;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  border-radius: 12px;
  padding: 18px 22px;
  margin: 16px 0;
  border: 1px solid rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.music-card:hover {
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
  border-color: rgba(73, 177, 245, 0.4);
}

.music-card .music-cover {
  flex-shrink: 0;
  width: 90px;
  height: 90px;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
}

.music-card .music-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.music-card .music-body {
  flex: 1;
  min-width: 0;
}

.music-card .music-title {
  font-size: 1.1em;
  font-weight: bold;
  color: #49b1f5;
}

.music-card .music-artist {
  font-size: 0.85em;
  color: #999;
  margin-bottom: 8px;
}

.music-card .music-player {
  width: 100%;
  height: 40px;
  display: block;
}

.music-card .music-lyrics {
  margin-top: 12px;
  font-size: 0.95em;
}

.music-card .music-lyrics summary {
  cursor: pointer;
  color: #49b1f5;
  font-weight: 600;
  outline: none;
  user-select: none;
}

.music-card .music-lyrics pre {
  margin: 8px 0 0;
  padding: 14px 18px;
  background: rgba(0, 0, 0, 0.05);
  border-left: 3px solid #49b1f5;
  border-radius: 8px;
  white-space: pre-wrap;
  line-height: 2;
  font-size: 1em;
  color: #2c3e50;
  max-height: 320px;
  overflow: auto;
  font-family: inherit;
}

/* 黑暗模式适配 */
[data-theme=dark] .music-card {
  background: rgba(25, 25, 25, 0.8);
}

[data-theme=dark] .music-card .music-lyrics pre {
  background: rgba(255, 255, 255, 0.08);
  color: #e8e8e8;
}

/* 移动端适配 */
@media screen and (max-width: 600px) {
  .music-card {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .music-card .music-cover {
    width: 120px;
    height: 120px;
  }
}

/* ---------- 左下角悬浮播放器 ---------- */
.music-float {
  position: fixed;
  left: 16px;
  bottom: 16px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 10px 14px;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 28px;
  border: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.16);
  width: 300px;
  max-width: calc(100vw - 20px);
  cursor: grab;
}

.music-float .music-float-main {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 10px;
  /* 仅主行作为拖动手柄；面板内元素（歌词滚动、音量滑块）需要独立触摸手势 */
  touch-action: none;
}

.music-float .music-float-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.music-float.dragging {
  cursor: grabbing;
  user-select: none;
  -webkit-user-select: none;
}

.music-float.snapping {
  transition: left 0.25s ease, top 0.25s ease;
}

/* 收起状态：隐藏悬浮窗，音频继续播放 */
.music-float.collapsed {
  display: none;
}

.music-float .music-float-cover {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  background: #eee;
}

.music-float .music-float-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  /* 始终应用旋转动画，用 play-state 控制暂停/播放，暂停或切换歌曲时保留当前角度 */
  animation: mf-spin 12s linear infinite;
  animation-play-state: paused;
}

.music-float.playing .music-float-cover img {
  animation-play-state: running;
}

@keyframes mf-spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.music-float .music-float-info {
  flex: 1;
  min-width: 0;
  line-height: 1.3;
}

.music-float .music-float-title {
  font-size: 0.95em;
  font-weight: bold;
  color: #2c3e50;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.music-float .music-float-artist {
  font-size: 0.8em;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.music-float .music-float-ctrl {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 5px 10px;
  border-radius: 999px;
  background: rgba(73, 177, 245, 0.08);
}

.music-float .mf-btn {
  width: 30px;
  height: 30px;
  flex-shrink: 0;
  border: none;
  border-radius: 50%;
  background: transparent;
  color: #49b1f5;
  font-size: 13px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.15s ease, color 0.2s ease;
  padding: 0;
}

.music-float .mf-btn:hover {
  background: rgba(73, 177, 245, 0.14);
  color: #49b1f5;
}

.music-float .mf-btn:active {
  transform: scale(0.9);
}

/* 播放/暂停按钮作为主按钮，更醒目 */
.music-float .mf-toggle {
  width: 38px;
  height: 38px;
  background: #49b1f5;
  color: #fff;
  font-size: 14px;
  box-shadow: 0 3px 10px rgba(73, 177, 245, 0.4);
}

.music-float .mf-toggle:hover {
  background: #3da4e0;
  color: #fff;
}

/* 静音降级播放时的提示态 */
.music-float.muted .music-float-cover img {
  animation-play-state: paused;
}

.music-float.muted .mf-toggle {
  background: #ff9800;
  color: #fff;
  box-shadow: 0 3px 10px rgba(255, 152, 0, 0.4);
}

.music-float.muted .mf-toggle:hover {
  background: #e68900;
}

/* ---------- 二级菜单：进度条 + 音量 + 歌词 ---------- */
.music-float .music-float-panel {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition: max-height 0.3s ease, opacity 0.3s ease;
}

.music-float.panel-open .music-float-panel {
  max-height: 360px;
  opacity: 1;
}

.music-float .music-float-panel-inner {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid rgba(0, 0, 0, 0.08);
}

.music-float .mf-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.music-float .mf-progress {
  gap: 6px;
}

.music-float .mf-time {
  flex-shrink: 0;
  min-width: 32px;
  font-size: 0.72em;
  color: #999;
  font-variant-numeric: tabular-nums;
  text-align: center;
}

.music-float .mf-progress-track {
  position: relative;
  flex: 1;
  height: 6px;
  border-radius: 4px;
  background: rgba(0, 0, 0, 0.12);
  cursor: pointer;
  touch-action: none;
}

.music-float .mf-progress-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 0;
  border-radius: 4px;
  background: #49b1f5;
  pointer-events: none;
}

.music-float .mf-volume .mf-btn {
  width: 28px;
  height: 28px;
  font-size: 12px;
}

.music-float .mf-volume-track {
  position: relative;
  flex: 1;
  height: 6px;
  border-radius: 4px;
  background: rgba(0, 0, 0, 0.12);
  cursor: pointer;
  touch-action: none;
}

.music-float .mf-volume-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 0;
  border-radius: 4px;
  background: #49b1f5;
  pointer-events: none;
}

/* 歌词区（默认常驻） */
.music-float .mf-lyrics {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.music-float .mf-lyrics-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.78em;
  color: #999;
}

.music-float .mf-lyrics-toggle {
  border: none;
  background: none;
  color: #49b1f5;
  cursor: pointer;
  font-size: 12px;
  padding: 2px 6px;
  border-radius: 6px;
  transition: background 0.2s ease;
}

.music-float .mf-lyrics-toggle:hover {
  background: rgba(73, 177, 245, 0.14);
}

.music-float .mf-lyrics-body {
  position: relative;
  max-height: 120px;
  overflow-y: auto;
  overflow-x: hidden;
  scroll-behavior: smooth;
  text-align: center;
  font-size: 0.8em;
  line-height: 1.8;
  color: #666;
  padding: 2px 0;
  touch-action: pan-y;
}

.music-float .mf-lyrics-line {
  padding: 1px 6px;
  transition: color 0.25s ease, transform 0.25s ease;
}

.music-float .mf-lyrics-line.active {
  color: #49b1f5;
  font-weight: bold;
  transform: scale(1.03);
}

.music-float .mf-lyrics-empty {
  color: #bbb;
  padding: 8px 0;
}

.music-float.lyrics-hidden .mf-lyrics-body {
  display: none;
}

.music-float .mf-menu i {
  transition: transform 0.2s ease;
}

.music-float .mf-menu.active {
  background: #49b1f5;
  color: #fff;
}

.music-float .mf-menu.active i {
  transform: rotate(180deg);
}

/* 黑暗模式 */
[data-theme=dark] .music-float {
  background: rgba(25, 25, 25, 0.9);
  border-color: rgba(255, 255, 255, 0.08);
}

[data-theme=dark] .music-float .music-float-title {
  color: #e8e8e8;
}

[data-theme=dark] .music-float .music-float-ctrl {
  background: rgba(255, 255, 255, 0.06);
}

[data-theme=dark] .music-float .music-float-panel-inner {
  border-top-color: rgba(255, 255, 255, 0.08);
}

[data-theme=dark] .music-float .mf-progress-track,
[data-theme=dark] .music-float .mf-volume-track {
  background: rgba(255, 255, 255, 0.16);
}

[data-theme=dark] .music-float .mf-lyrics-line {
  color: #bbb;
}

[data-theme=dark] .music-float .mf-lyrics-line.active {
  color: #49b1f5;
}

/* 移动端：悬浮窗收窄，隐藏歌手信息，改为内容宽度悬浮而非通栏 */
@media screen and (max-width: 600px) {
  .music-float {
    left: 10px;
    bottom: 10px;
    width: 240px;
    max-width: calc(100vw - 20px);
    padding: 8px 10px;
    border-radius: 24px;
  }

  .music-float .music-float-cover {
    width: 36px;
    height: 36px;
  }

  .music-float .music-float-info {
    min-width: 0;
  }

  .music-float .music-float-artist {
    display: none;
  }

  .music-float .music-float-ctrl {
    gap: 4px;
  }

  .music-float .mf-btn {
    width: 26px;
    height: 26px;
    font-size: 11px;
  }

  .music-float .mf-toggle {
    width: 32px;
    height: 32px;
    font-size: 12px;
  }

  .music-float .music-float-title {
    font-size: 0.88em;
  }
}